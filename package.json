{
  "name": "experience-the-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "kits/*"
  ],
  "scripts": {
    "dev": "node tools/start-dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/platform/vite.config.ts",
    "preview": "vite preview --config apps/platform/vite.config.ts",
    "check": "node tools/check-boundaries.mjs",
    "test": "node --import tsx --test packages/*/tests/*.test.ts* kits/*/tests/*.test.ts* apps/platform/tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "functions:check": "wrangler pages functions build functions --outdir .functions-check",
    "rooms": "node --import tsx tools/rooms.mjs",
    "test:browser:voice": "node tests/voice-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsonc-parser": "^3.3.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "^4.129.0"
  }
}
