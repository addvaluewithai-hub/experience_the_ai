{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "experience-the-ai",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  // No vars here on purpose: GEMINI_API_KEY, OPEN_AI_PREVIEW and the optional GEMINI_CHAT_MODEL
  // are set per environment as secrets in the Cloudflare dashboard (see docs/deploy.md).
}
